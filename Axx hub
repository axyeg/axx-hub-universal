    }, core)
    local corePulse = new("UIScale", { Scale = 1 }, coreInner)
    for i = 1, 7 do
        local d = 120 + i * 62
        local c = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
