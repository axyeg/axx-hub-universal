    local function shockwave(final, thick, time)
        local f = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(CX, CY),
            Size = UDim2.fromOffset(40, 40),
            BackgroundTransparency = 1,
        }, stage)
        round(f)
        local s = new("UIStroke", { Thickness = thick, Color = C.Frost, Transparency = 0.3 }, f)
        tw(f, time, { Size = UDim2.fromOffset(final, final) }, Enum.EasingStyle.Quint)
        tw(s, time, { Transparency = 1, Thickness = 0.5 })
        task.delay(time + 0.1, function() f:Destroy() end)
    end

    local function burst(count)
        for i = 1, count do
            local angle = rng:NextNumber(0, math.pi * 2)
            local dist = rng:NextNumber(150, 330)
            local size = rng:NextInteger(2, 4)
            local p = frame({
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromOffset(CX, CY),
                Size = UDim2.fromOffset(size, size),
                BackgroundColor3 = (i % 3 == 0) and C.White or C.Ice,
            }, stage)
            round(p)
            local dur = rng:NextNumber(0.7, 1.2)
            tw(p, dur, {
                Position = UDim2.fromOffset(CX + math.cos(angle) * dist, CY + math.sin(angle) * dist),
            }, Enum.EasingStyle.Quint)
            tw(p, dur, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
