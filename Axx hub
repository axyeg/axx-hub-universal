    local function makeRing(diameter, thickness, color, startAlpha)
        local f = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(CX, CY),
            Size = UDim2.fromOffset(diameter, diameter),
            BackgroundTransparency = 1,
        }, stage)
        round(f)
        local s = new("UIStroke", { Thickness = thickness, Color = color, Transparency = startAlpha }, f)
        local sc = new("UIScale", { Scale = 0.75 }, f)
        return s, sc
    end

    local ringBaseStroke, ringBaseScale = makeRing(620, 1, C.Ice, 1)
    local ringArcAStroke, ringArcAScale = makeRing(620, 3, C.White, 1)
    local gradA = grad(ringArcAStroke, nil, {
        { 0, 1 }, { 0.3, 1 }, { 0.5, 0 }, { 0.7, 1 }, { 1, 1 },
    }, 0)
    local ringInStroke, ringInScale = makeRing(572, 1, C.Light, 1)
    local ringArcBStroke, ringArcBScale = makeRing(572, 2, C.Light, 1)
    local gradB = grad(ringArcBStroke, nil, {
        { 0, 1 }, { 0.38, 1 }, { 0.5, 0.05 }, { 0.62, 1 }, { 1, 1 },
    }, 0)

    local function sparkle(size, x, y)
        local holder = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(x, y),
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
        }, stage)
        local scale = new("UIScale", { Scale = 0 }, holder)
        local vertical = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(0, 2, 1, 0),
            BackgroundColor3 = C.Frost,
        }, holder)
        grad(vertical, nil, { { 0, 1 }, { 0.5, 0 }, { 1, 1 } }, 90)
        local horizontal = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, 0, 0, 2),
            BackgroundColor3 = C.Frost,
        }, holder)
        grad(horizontal, nil, { { 0, 1 }, { 0.5, 0 }, { 1, 1 } }, 0)
        for _, rot in ipairs({ 45, -45 }) do
            local d = frame({
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.new(0.5, 0, 0, 1),
                Rotation = rot,
                BackgroundColor3 = C.Ice,
            }, holder)
            grad(d, nil, { { 0, 1 }, { 0.5, 0.2 }, { 1, 1 } }, 0)
        end
        frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(math.max(4, size * 0.14), math.max(4, size * 0.14)),
            Rotation = 45,
            BackgroundColor3 = C.White,
        }, holder)
        return { holder = holder, scale = scale, phase = rng:NextNumber(0, 6.28), ready = false }
    end

    local sparkles = {
        sparkle(74, CX, CY - 312),
        sparkle(74, CX, CY + 312),
        sparkle(44, CX - 312, CY),
        sparkle(44, CX + 312, CY),
    }

    local function makeLine(y, width)
        local line = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset(CX, y),
            Size = UDim2.fromOffset(0, 1),
            BackgroundColor3 = C.Ice,
            BackgroundTransparency = 0.25,
        }, stage)
        grad(line, nil, { { 0, 1 }, { 0.5, 0 }, { 1, 1 } }, 0)
        return function(time)
            tw(line, time or 1, { Size = UDim2.fromOffset(width, 1) }, Enum.EasingStyle.Quint)
        end
    end

    local lineTop = makeLine(250, 400)
    local lineBottom = makeLine(466, 460)
    local sparkTop = sparkle(34, CX, 250)
    local sparkBottom = sparkle(30, CX, 466)
    sparkles[#sparkles + 1] = sparkTop
    sparkles[#sparkles + 1] = sparkBottom

    local titleHolder = frame({
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(CX, TITLE_Y),
        Size = UDim2.fromOffset(560, 110),
        BackgroundTransparency = 1,
    }, stage)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 12),
    }, titleHolder)

    local LH, T = 88, 9

    local function segments(kind, w, h, t)
        if kind == "A" then
            return {
                { t * 0.4, h, w / 2, t * 0.2 },
                { w - t * 0.4, h, w / 2, t * 0.2 },
                { w * 0.26, h * 0.68, w * 0.74, h * 0.68 },
            }
        elseif kind == "X" then
            return {
                { t * 0.3, 0, w - t * 0.3, h },
                { w - t * 0.3, 0, t * 0.3, h },
            }
        elseif kind == "H" then
            return {
                { t / 2, 0, t / 2, h },
                { w - t / 2, 0, w - t / 2, h },
                { t / 2, h / 2, w - t / 2, h / 2 },
            }
        elseif kind == "U" then
            return {
                { t / 2, 0, t / 2, h - t * 1.7 },
                { w - t / 2, 0, w - t / 2, h - t * 1.7 },
                { t / 2, h - t * 1.7, t * 1.6, h - t / 2 },
                { w - t / 2, h - t * 1.7, w - t * 1.6, h - t / 2 },
                { t * 1.6, h - t / 2, w - t * 1.6, h - t / 2 },
            }
        elseif kind == "B" then
            return {
                { t / 2, 0, t / 2, h },
                { 0, t / 2, w * 0.64, t / 2 },
                { w * 0.64, t / 2, w * 0.86, h * 0.18 },
                { w * 0.86, h * 0.18, w * 0.86, h * 0.34 },
                { w * 0.86, h * 0.34, w * 0.68, h / 2 },
                { 0, h / 2, w * 0.68, h / 2 },
                { w * 0.68, h / 2, w * 0.94, h * 0.66 },
                { w * 0.94, h * 0.66, w * 0.94, h * 0.84 },
                { w * 0.94, h * 0.84, w * 0.72, h - t / 2 },
                { 0, h - t / 2, w * 0.72, h - t / 2 },
            }
        end
        return {}
    end

    local function bar(parentObj, seg, thick, color, z)
        local x1, y1, x2, y2 = seg[1], seg[2], seg[3], seg[4]
        local dx, dy = x2 - x1, y2 - y1
        local len = math.sqrt(dx * dx + dy * dy) + thick * 0.45
        return frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2),
            Size = UDim2.fromOffset(len, thick),
            Rotation = math.deg(math.atan2(dy, dx)),
            BackgroundColor3 = color,
            BackgroundTransparency = 1,
            ZIndex = z,
        }, parentObj)
    end

    local defs = {
        { k = "A", w = 72 }, { k = "X", w = 66 }, { k = "X", w = 66 }, { k = "_", w = 26 },
        { k = "H", w = 62 }, { k = "U", w = 62 }, { k = "B", w = 62 },
    }

    local letters = {}
    for i, def in ipairs(defs) do
        local holder = frame({
            Size = UDim2.fromOffset(def.w, LH),
            BackgroundTransparency = 1,
            LayoutOrder = i,
        }, titleHolder)
        if def.k ~= "_" then
            local scale = new("UIScale", { Scale = 1.3 }, holder)
            local body = frame({
                Size = UDim2.fromScale(1, 1),
                Position = UDim2.new(0, 0, 0, 40),
                BackgroundTransparency = 1,
            }, holder)
            local segs = segments(def.k, def.w, LH, T)
            local glows, bars, strokes = {}, {}, {}
            for _, seg in ipairs(segs) do
                glows[#glows + 1] = bar(body, seg, T + 10, C.Light, 1)
            end
            for _, seg in ipairs(segs) do
                local b = bar(body, seg, T, C.White, 2)
                local st = new("UIStroke", { Thickness = 1, Color = C.Light, Transparency = 1 }, b)
                bars[#bars + 1] = b
                strokes[#strokes + 1] = st
            end
            letters[#letters + 1] = {
                body = body, scale = scale,
                glows = glows, bars = bars, strokes = strokes,
                index = #letters + 1,
            }
        end
    end

    local function revealLetter(l)
        for _, b in ipairs(l.bars) do
            tw(b, 0.5, { BackgroundTransparency = 0 })
        end
        for _, s in ipairs(l.strokes) do
            tw(s, 0.5, { Transparency = 0.45 })
        end
        for _, g in ipairs(l.glows) do
            tw(g, 0.8, { BackgroundTransparency = 0.86 })
        end
        tw(l.body, 0.7, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back)
        tw(l.scale, 0.7, { Scale = 1 }, Enum.EasingStyle.Back)
    end

    local function sweepShine()
        for _, l in ipairs(letters) do
            task.delay((l.index - 1) * 0.07, function()
                for _, b in ipairs(l.bars) do
                    tw(b, 0.2, { BackgroundColor3 = C.Light })
                    task.delay(0.2, function()
                        tw(b, 0.5, { BackgroundColor3 = C.White })
                    end)
                end
            end)
        end
    end

    local subRow = frame({
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromOffset(CX, 410),
        Size = UDim2.fromOffset(0, 24),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
    }, stage)
    new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 12),
    }, subRow)

    local subItems = {}

    local function subLine(order, flip)
        local line = frame({
            Size = UDim2.fromOffset(58, 1),
