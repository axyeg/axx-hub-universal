        local tick = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(major and 3 or 2, len),
            Position = UDim2.fromOffset(330 + math.cos(rad) * radius, 330 + math.sin(rad) * radius),
            Rotation = deg + 90,
            BackgroundColor3 = major and C.Frost or C.Ice,
            BackgroundTransparency = 1,
        }, dial)
        at(0.25 + i * 0.01, function()
            tw(tick, 0.4, { BackgroundTransparency = major and 0.15 or 0.6 })
        end)
