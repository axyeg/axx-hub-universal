        grad(m, nil, { { 0, 1 }, { 0.5, 0.955 }, { 1, 1 } }, 0)
        mists[i] = {
            obj = m,
            y = 0.15 + i * 0.28,
            speed = rng:NextNumber(0.12, 0.28),
            phase = rng:NextNumber(0, 6.28),
            range = rng:NextNumber(0.03, 0.07),
        }
    end

    local starLayer = layer(3)
    local stars = {}
    for i = 1, 80 do
        local size = rng:NextInteger(1, 3)
        local s = frame({
            Size = UDim2.fromOffset(size, size),
            Position = UDim2.fromScale(rng:NextNumber(), rng:NextNumber()),
            BackgroundColor3 = (i % 4 == 0) and C.Ice or C.White,
            BackgroundTransparency = 1,
        }, starLayer)
        round(s)
        stars[i] = {
            obj = s,
            speed = rng:NextNumber(0.8, 2.6),
            phase = rng:NextNumber(0, 6.28),
            peak = rng:NextNumber(0.35, 0.9),
        }
    end

    local dust = {}
    for i = 1, 16 do
        local d = frame({
            Size = UDim2.fromOffset(3, 3),
            BackgroundColor3 = C.Ice,
            BackgroundTransparency = 1,
        }, starLayer)
        round(d)
        dust[i] = {
            obj = d,
            x = rng:NextNumber(),
            y = rng:NextNumber(),
            speed = rng:NextNumber(0.01, 0.03),
            sway = rng:NextNumber(0.01, 0.03),
            phase = rng:NextNumber(0, 6.28),
        }
    end

    local vignette = layer(8)
    local function edge(anchor, pos, size, rotation)
        local e = frame({
            AnchorPoint = anchor,
            Position = pos,
            Size = size,
            BackgroundColor3 = C.Void,
