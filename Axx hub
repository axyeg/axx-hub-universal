local introGui

local function runIntro()
    local Players = game:GetService("Players")
    local TweenService = game:GetService("TweenService")
    local RunService = game:GetService("RunService")
    local lp = Players.LocalPlayer

    local okHui, hui = pcall(function() return gethui and gethui() end)
    local parent = (okHui and hui) or lp:WaitForChild("PlayerGui")

    local C = {
        Void  = Color3.fromHex("#000000"),
        Deep  = Color3.fromHex("#04060b"),
        Navy  = Color3.fromHex("#0a1020"),
        Blue  = Color3.fromHex("#7aa7f5"),
        Light = Color3.fromHex("#9fc3ff"),
        Ice   = Color3.fromHex("#c4daff"),
        Frost = Color3.fromHex("#e8f0ff"),
        White = Color3.new(1, 1, 1),
    }
    local SFX = { BOOM = "9118823100", WHOOSH = "9114663715", CLICK = "9125401346", RISE = "9045889306" }
    local STAGE_W, STAGE_H = 1100, 700
    local CX, CY = 550, 350
    local TITLE_Y = 322
    local rng = Random.new()

    local function new(class, props, parentObj)
        local obj = Instance.new(class)
        if props then
            for key, value in pairs(props) do
                obj[key] = value
            end
        end
        obj.Parent = parentObj
        return obj
    end

    local function frame(props, parentObj)
        local p = { BorderSizePixel = 0, BackgroundColor3 = C.White }
        for key, value in pairs(props or {}) do
            p[key] = value
        end
        return new("Frame", p, parentObj)
    end

    local function round(obj)
        return new("UICorner", { CornerRadius = UDim.new(1, 0) }, obj)
    end

    local function colors(list)
        local kp = {}
        for i, item in ipairs(list) do
            kp[i] = ColorSequenceKeypoint.new(item[1], item[2])
        end
        return ColorSequence.new(kp)
    end

    local function alphas(list)
        local kp = {}
        for i, item in ipairs(list) do
            kp[i] = NumberSequenceKeypoint.new(item[1], item[2])
        end
        return NumberSequence.new(kp)
    end

    local function grad(obj, colorList, alphaList, rotation)
        local g = Instance.new("UIGradient")
        if colorList then g.Color = colors(colorList) end
        if alphaList then g.Transparency = alphas(alphaList) end
        g.Rotation = rotation or 0
        g.Parent = obj
        return g
    end

    local function tw(obj, time, props, style, dir)
        local tween = TweenService:Create(
            obj,
            TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out),
            props
        )
        tween:Play()
        return tween
    end

    local function snd(id, vol, pitch)
        pcall(function()
            local s = Instance.new("Sound")
            s.SoundId = "rbxassetid://" .. id
            s.Volume = vol or 0.6
            s.PlaybackSpeed = pitch or 1
            s.Parent = SoundService
            s:Play()
            task.delay(6, function() s:Destroy() end)
        end)
    end

    local function at(time, fn)
        task.delay(time, function()
            local ok, err = pcall(fn)
            if not ok then warn("[AxxHub] intro:", err) end
        end)
    end

    local gui = new("ScreenGui", {
        Name = "AxxHub_Intro",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        DisplayOrder = 10000,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    }, parent)
    pcall(function() gui.ScreenInsets = Enum.ScreenInsets.None end)
    introGui = gui

    local bg = frame({
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromScale(1.05, 1.05),
        ZIndex = 0,
        Active = true,
    }, gui)
    grad(bg, {
        { 0, Color3.fromHex("#05070d") },
        { 0.55, C.Void },
        { 1, Color3.fromHex("#070d1a") },
    }, nil, 90)

    local content = new("CanvasGroup", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        GroupTransparency = 1,
        ZIndex = 1,
    }, gui)

    local function layer(z)
        return frame({
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ZIndex = z,
        }, content)
    end

    local mistLayer = layer(2)
    local mists = {}
    for i = 1, 3 do
        local m = frame({
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromScale(1.8, 0.22 + i * 0.05),
            Position = UDim2.fromScale(0.5, 0.15 + i * 0.28),
            BackgroundColor3 = C.Light,
